# Copy to .env in virm's data directory (`virm paths` shows where).
# A .env in the current directory works too. Never commit the real file.

# Free key for the d1 decision model: https://console.liquid.ai
LIQUID_API_KEY=liquid_...

# Notifications, all optional. Desktop notifications need nothing.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# VIRM_WEBHOOK_URL=https://example.com/your-endpoint
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# EMAIL_TO=you@example.com
# EMAIL_FROM=virm@example.com

# VIRM_HOME moves the data folder elsewhere, but it cannot be set in this file:
# it decides where this file is. Set it in your environment instead.
